# 复制到 .runtime/ai-service.env 后填写随机凭证；Java 与 Python 必须使用相同值。
AI_SERVICE_TOKEN=replace-with-private-random-service-credential
# Python 实际监听地址及端口；默认仅接收本机请求。
AI_HOST=127.0.0.1
AI_PORT=8102
# Nacos 服务名，与 Java 的 ai.service.name 一致。
AI_SERVICE_NAME=mianshiya-ai-service
# 提供给调用者连接的地址，不能使用 0.0.0.0；跨主机时填写可达 IP。
AI_REGISTER_IP=127.0.0.1
# Python 应用和 Uvicorn 的日志级别。
AI_LOG_LEVEL=INFO
# 本机 Nacos 的 HTTP 地址；SDK 还会连接其 +1000 的 gRPC 端口（默认 9848）。
NACOS_SERVER_ADDR=127.0.0.1:8848
# 空值表示 public；自定义 namespace 必须填写 ID 而非显示名称。
NACOS_NAMESPACE=
# Java 和 Python 必须位于同一 group，才能发现彼此的实例。
NACOS_GROUP=DEFAULT_GROUP
# 真实模型配置，仅 Python 读取；Base URL 不包含 /chat/completions。
OPENAI_MODEL_ENABLED=false
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
# Python 总预算默认 30 秒；Java 模型接口读取预算需比它更长。
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_TOKENS=512
OPENAI_MAX_CONCURRENCY=2
# 问镜 AI 模拟面试开关；对话模型复用上方 OPENAI_*，会话与检查点存独立 MySQL 库。
WENJING_ENABLED=false
CHECKPOINT_BACKEND=mysql
AI_MYSQL_HOST=127.0.0.1
AI_MYSQL_PORT=3306
# 库名必须以 mianshiwa_ai_ 开头，账号只授予该库权限。
WENJING_MYSQL_DATABASE=mianshiwa_ai_wenjing
AI_MYSQL_USER=
AI_MYSQL_PASSWORD=
# 知识库与简历锚点向量存 ES（索引前缀 mianshiwa-ai-wenjing-）。
AI_ES_URL=http://127.0.0.1:9201
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# 复用 Docker Redis，使用独立 DB 与键前缀，避免混入原后端缓存。
REDIS_URL=redis://127.0.0.1:6380/1
RESUME_PARSE_CACHE_BACKEND=redis
RESUME_PARSE_CACHE_REDIS_PREFIX=mianshiwa:ai:resume_parse
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_PREFIX=mianshiwa:ai:rate_limit
# 问镜节点的输出预算；与上方模型连通性测试的 OPENAI_MAX_TOKENS 分开。
# 评分包含证据引用，训练计划包含阶段目标，DeepSeek 思考也会消耗输出预算。
EVALUATOR_LLM_MAX_TOKENS=8192
COACH_LLM_MAX_TOKENS=8192
